{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://de.dev/ui-provenance/schemas/config-1.0.json",
  "title": "UI Provenance configuration",
  "type": "object",
  "required": ["applicationId", "repository", "include", "registry"],
  "additionalProperties": false,
  "properties": {
    "applicationId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repository": { "type": "string", "minLength": 1 },
    "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "registry": { "type": "string", "minLength": 1 },
    "saltPackages": { "type": "array", "items": { "type": "string" } },
    "ambiguousMatchThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "tombstoneRetentionDays": { "type": "integer", "minimum": 0 },
    "productionDisabled": { "type": "boolean" },
    "federation": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["host", "remote"] },
        "exposes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
